{
  "id": "STORY-0010",
  "title": "GQL parser, planner and conformance matrix",
  "epic": "EPIC-0004",
  "narrative": "As a developer, I want a GQL front end with a published conformance matrix so that I know exactly which GQL features work.",
  "requirements": [
    "REQ-0003"
  ],
  "deliverable": "code",
  "component": "server",
  "acceptance_criteria": [],
  "evals": [
    {
      "id": "E1",
      "name": "matrix completeness vs ISO/IEC 39075",
      "kind": "static",
      "command": "scripts/gql/check-matrix.py docs/gql-conformance.toml --against 'spec/ISO_IEC_39075(en)-features.xml' --require-status",
      "covers": [
        "REQ-0003#AC1"
      ]
    },
    {
      "id": "E2",
      "name": "GQL conformance suite",
      "kind": "contract",
      "command": "cargo test -p dscore-server --test gql_conformance -- --matrix docs/gql-conformance.toml",
      "covers": [
        "REQ-0003#AC2"
      ]
    },
    {
      "id": "E3",
      "name": "unsupported and non-GQL syntax rejected with feature-named error",
      "kind": "contract",
      "command": "cargo test -p dscore-server --test gql_negative -- unsupported_feature_named sql_input_rejected",
      "covers": [
        "REQ-0003#AC3"
      ]
    }
  ],
